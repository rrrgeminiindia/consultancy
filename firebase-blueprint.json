{
  "entities": {
    "Candidate": {
      "title": "Candidate",
      "description": "IT Job Candidate record in the recruitment flow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "contactNumber": { "type": "string", "maxLength": 40 },
        "jobTitle": { "type": "string", "maxLength": 120 },
        "jobLocation": { "type": "string", "maxLength": 120 },
        "totalItExperience": { "type": "string", "maxLength": 40 },
        "relevantExperience": { "type": "string", "maxLength": 500 },
        "currentLocation": { "type": "string", "maxLength": 120 },
        "workAuthorization": { "type": "string", "maxLength": 80 },
        "currentEmployer": { "type": "string", "maxLength": 120 },
        "noticePeriod": { "type": "string", "maxLength": 60 },
        "applicationDate": { "type": "string" },
        "linkedInJobOpening": { "type": "string", "maxLength": 160 },
        "assignedTeammateId": { "type": "string" },
        "assignedTeammateName": { "type": "string" },
        "assignmentDate": { "type": "string" },
        "stage": {
          "type": "string",
          "enum": [
            "New Candidate",
            "Initial Email Sent",
            "Documents Pending",
            "Documents Received",
            "Ready for Teammate Call",
            "Call Pending",
            "Call Completed",
            "Withdrawn",
            "Closed"
          ]
        },
        "resumeStatus": {
          "type": "string",
          "enum": ["Pending", "Received"]
        },
        "candidateFormStatus": {
          "type": "string",
          "enum": ["Pending", "Received"]
        },
        "identityVerificationStatus": {
          "type": "string",
          "enum": ["Pending", "Verified", "Not Required"]
        },
        "lastContactDate": { "type": "string" },
        "nextFollowUpDate": { "type": "string" },
        "callPendingStartedAt": { "type": "string" },
        "stageEnteredAt": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "fullName",
        "email",
        "jobTitle",
        "stage",
        "resumeStatus",
        "candidateFormStatus"
      ]
    },
    "Teammate": {
      "title": "Teammate",
      "description": "Recruiter teammate assigned to candidates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "maxCapacity": { "type": "number" }
      },
      "required": ["name", "email", "title"]
    },
    "JobOpening": {
      "title": "JobOpening",
      "description": "IT Job posting opening",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 120 },
        "type": { "type": "string" },
        "active": { "type": "boolean" },
        "formTemplateId": { "type": "string" },
        "requiredExperienceYears": { "type": "number" },
        "openingsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "department", "location"]
    },
    "CandidateFormTemplate": {
      "title": "CandidateFormTemplate",
      "description": "Configurable candidate info form template",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 140 },
        "jobOpeningId": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Recruiter email message templates with placeholders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "title": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 300 },
        "subject": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 4000 },
        "recommendedStage": { "type": "string" }
      },
      "required": ["key", "title", "subject", "body"]
    }
  },
  "firestore": {
    "/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/Candidate" },
      "description": "Candidate records with recruitment stage, documents, and assignment"
    },
    "/teammates/{teammateId}": {
      "schema": { "$ref": "#/entities/Teammate" },
      "description": "Teammates and recruiters in the organization"
    },
    "/jobOpenings/{jobOpeningId}": {
      "schema": { "$ref": "#/entities/JobOpening" },
      "description": "Published job openings"
    },
    "/formTemplates/{formTemplateId}": {
      "schema": { "$ref": "#/entities/CandidateFormTemplate" },
      "description": "Configurable candidate form questions per job opening"
    },
    "/emailTemplates/{emailTemplateId}": {
      "schema": { "$ref": "#/entities/EmailTemplate" },
      "description": "Recruiter follow-up and outreach email templates"
    }
  }
}
